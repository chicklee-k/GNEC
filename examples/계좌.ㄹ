/ㄹ 은행 계좌: 구조체 + 함수 + 예외 처리 ㄹ/
구조체 계좌 {
    선언 주인;
    선언 잔액;
    선언 내역[];
}

함수 K-개설(이름) {
    선언 c 는 새로 계좌();
    c.주인 는 이름;
    c.잔액 는 0;
    돌려주기 c;
}

함수 K-입금(c, 금액) {
    만약 (금액 <= 0) { 돌려주기 1 / 0; }   /ㄹ 잘못된 금액 → 예외 발생 ㄹ/
    c.잔액 는 c.잔액 + 금액;
    추가(c.내역, "+" + 금액);
}

함수 K-출금(c, 금액) {
    만약 (금액 > c.잔액) { 선언 부족 는 없는변수; }   /ㄹ 정의되지 않은 이름 → 예외 ㄹ/
    c.잔액 는 c.잔액 - 금액;
    추가(c.내역, "-" + 금액);
}

프로그램 {
    선언 내계좌 는 K-개설("민수");
    K-입금(내계좌, 10000);
    K-출금(내계좌, 3000);

    시도 {
        K-출금(내계좌, 50000);
    } 예외 (e) {
        콘솔.로그("출금 거절 (잔액 부족)");
    }

    시도 {
        K-입금(내계좌, -500);
    } 예외 (e) {
        콘솔.로그("입금 거절 (잘못된 금액)");
    }

    콘솔.로그("${내계좌.주인}님 잔액: ${내계좌.잔액}원");
    콘솔.로그("거래 내역:", 내계좌.내역);
}
