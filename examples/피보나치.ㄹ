/ㄹ 재귀 vs 반복 피보나치 ㄹ/
함수 K-피보재귀(n) {
    만약 (n < 2) { 돌려주기 n; }
    돌려주기 K-피보재귀(n - 1) + K-피보재귀(n - 2);
}

함수 K-피보반복(n) {
    선언 a 는 0;
    선언 b 는 1;
    선언 i 는 0;
    반복 (i < n) {
        선언 t 는 a + b;
        a 는 b;
        b 는 t;
        i++;
    }
    돌려주기 a;
}

프로그램 {
    선언 i 는 0;
    선언 줄 는 [];
    반복 (i <= 15) { 추가(줄, K-피보재귀(i)); i++; }
    콘솔.로그("재귀:", 줄);
    콘솔.로그("반복 fib(70) =", K-피보반복(70));

    /ㄹ 너무 깊은 재귀는 예외로 잡을 수 있다 ㄹ/
    함수 K-무한(n) { 돌려주기 K-무한(n + 1); }
    시도 { K-무한(0); } 예외 (e) { 콘솔.로그("잡음:", e); }
}
