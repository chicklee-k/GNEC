/ㄹ 원본 예제 "교과서" 의 구조(구조체+배열필드+입력+반복+try)를 중립 키워드로 옮긴 것 ㄹ/
구조체 책 {
    선언 저자;
    선언 내용[];
}

가져오기 자료.문서1;
가져오기 자료.문서2;

프로그램 {
    함수 K-편찬(제목) {
        선언 교과서 는 새로 책();
        교과서.저자 는 "편집부";
        시도 {
            교과서.내용[0] 는 제목 + "-서문";
            교과서.내용[1] 는 제목 + "-본문";
            교과서.내용[2] 는 제목 + "-부록";
            돌려주기 교과서;
        } 예외 (문제) {
            콘솔.로그("편찬 중 오류:", 문제);
            돌려주기 없음;
        }
    }
    선언 책1 는 K-편찬("역사");
    콘솔.로그(책1.저자, "/", 길이(책1.내용), "장");
    선언 i 는 0;
    반복 (i < 길이(책1.내용)) { 콘솔.로그(" ", 책1.내용[i]); i++; }
}
