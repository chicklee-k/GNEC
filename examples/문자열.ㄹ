/ㄹ 문자열 다루기: 한글도 글자 단위로 인덱싱된다 ㄹ/
함수 K-뒤집기(s) {
    선언 결과 는 "";
    선언 i 는 길이(s) - 1;
    반복 (i >= 0) { 결과 는 결과 + s[i]; i--; }
    돌려주기 결과;
}

함수 K-회문인가(s) {
    돌려주기 s == K-뒤집기(s);
}

프로그램 {
    선언 단어들 는 ["기러기", "토마토", "안녕하세요", "level", "GNEC"];
    선언 i 는 0;
    반복 (i < 길이(단어들)) {
        선언 w 는 단어들[i];
        선언 판정 는 "아님";
        만약 (K-회문인가(w)) { 판정 는 "회문"; }
        콘솔.로그("${w} (${길이(w)}글자) -> 뒤집으면 ${K-뒤집기(w)} : ${판정}");
        i++;
    }
}
