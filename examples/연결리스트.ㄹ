/ㄹ 연결 리스트: 객체가 다른 객체를 필드로 가리킨다 ㄹ/
구조체 노드 {
    선언 값;
    선언 다음;
}

함수 K-앞에추가(머리, 값) {
    선언 n 는 새로 노드();
    n.값 는 값;
    n.다음 는 머리;
    돌려주기 n;
}

함수 K-출력(머리) {
    선언 결과 는 "";
    선언 현재 는 머리;
    반복 (현재 != 없음) {
        결과 는 결과 + 현재.값;
        만약 (현재.다음 != 없음) { 결과 는 결과 + " -> "; }
        현재 는 현재.다음;
    }
    콘솔.로그(결과);
}

함수 K-뒤집기(머리) {
    선언 이전 는 없음;
    선언 현재 는 머리;
    반복 (현재 != 없음) {
        선언 다음것 는 현재.다음;
        현재.다음 는 이전;
        이전 는 현재;
        현재 는 다음것;
    }
    돌려주기 이전;
}

프로그램 {
    선언 목록 는 없음;
    선언 i 는 5;
    반복 (i >= 1) { 목록 는 K-앞에추가(목록, i); i--; }
    K-출력(목록);
    목록 는 K-뒤집기(목록);
    K-출력(목록);
}
