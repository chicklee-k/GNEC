/ㄹ 에라토스테네스의 체로 100 이하 소수 구하기 ㄹ/
프로그램 {
    선언 최대 는 100;
    선언 체 는 [];
    선언 i 는 0;
    반복 (i <= 최대) { 체[i] 는 참; i++; }
    체[0] 는 거짓;
    체[1] 는 거짓;

    선언 p 는 2;
    반복 (p * p <= 최대) {
        만약 (체[p]) {
            선언 배수 는 p * p;
            반복 (배수 <= 최대) { 체[배수] 는 거짓; 배수 는 배수 + p; }
        }
        p++;
    }

    선언 소수들 는 [];
    i 는 2;
    반복 (i <= 최대) {
        만약 (체[i]) { 추가(소수들, i); }
        i++;
    }
    콘솔.로그("${최대} 이하 소수 ${길이(소수들)}개:");
    콘솔.로그(소수들);
}
