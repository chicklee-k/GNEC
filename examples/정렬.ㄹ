/ㄹ 버블 정렬: 배열을 넘기면 제자리에서 정렬된다 (배열은 참조로 전달) ㄹ/
함수 K-버블정렬(배열) {
    선언 n 는 길이(배열);
    선언 i 는 0;
    반복 (i < n - 1) {
        선언 j 는 0;
        반복 (j < n - 1 - i) {
            만약 (배열[j] > 배열[j + 1]) {
                선언 임시 는 배열[j];
                배열[j] 는 배열[j + 1];
                배열[j + 1] 는 임시;
            }
            j++;
        }
        i++;
    }
}

프로그램 {
    선언 수들 는 [42, 7, 19, 3, 88, 25, 1];
    콘솔.로그("정렬 전:", 수들);
    K-버블정렬(수들);
    콘솔.로그("정렬 후:", 수들);

    선언 이름들 는 ["다현", "가윤", "나래"];
    K-버블정렬(이름들);
    콘솔.로그("이름순:", 이름들);
}
